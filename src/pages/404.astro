---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="That page doesn't exist." index={false}>
  <section class="section section--head section--tail">
    <p class="eyebrow page-eyebrow">404</p>
    <h1 class="page-title">That page doesn't exist</h1>
    <p class="lead page-lead">
      The link may be out of date, or the page may have moved during the site rebuild.
    </p>
    <div class="actions page-actions">
      <a class="btn" href="/">Back to home</a>
      <a class="btn-quiet" href="/events">See events</a>
    </div>
  </section>
</Base>

<style>
  .page-eyebrow {
    display: block;
    margin-bottom: clamp(24px, 3vw, 36px);
  }

  .page-lead {
    margin-top: clamp(24px, 3vw, 36px);
  }

  .page-actions {
    margin-top: 32px;
  }
</style>
