---
/**
 * Primary navigation.
 *
 * A sticky band with the wordmark and a single row of links. There is
 * deliberately no hamburger: six short labels wrap onto two rows on a phone,
 * which keeps every destination visible and one tap away instead of hiding
 * them behind a control that needs JS to open.
 */

import { navItems } from '../data/site';
import Logo from './Logo.astro';

const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';

function isCurrent(href: string, external?: boolean) {
  if (external) return false;
  return href === '/' ? path === '/' : path === href;
}
---

<header class="nav">
  <div class="nav__inner wrap">
    <a href="/" class="nav__brand" aria-label="FACE — home">
      <Logo width={124} />
    </a>

    <nav class="nav__menu" aria-label="Primary">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="nav__link"
            aria-current={isCurrent(item.href, item.external) ? 'page' : undefined}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener noreferrer' : undefined}
          >
            {item.label}
            {item.external && <span class="nav__external" aria-hidden="true">↗</span>}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .nav {
    /* Opaque, not translucent: content scrolling underneath a blur would
       fight the hairline rules this design is built from. */
    background: var(--bg);
    border-bottom: 1px solid var(--rule);
  }

  /* The bar only sticks once the links fit on one row with the wordmark.
     Below that they wrap to two rows and a pinned bar would hold on to a
     fifth of a phone screen for the whole scroll, so it scrolls away
     instead. The links stay visible on arrival either way. */
  @media (min-width: 44rem) {
    .nav {
      position: sticky;
      top: 0;
      z-index: var(--z-nav);
    }
  }

  .nav__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    /* Column gap only. Between roughly 544px and 596px the menu wraps under
       the wordmark, and a 24px row gap there bought nothing but 24px of bar:
       the wordmark already carries its own 12px of padding underneath. */
    column-gap: 24px;
    row-gap: 0;
    min-height: var(--header-height);
  }

  .nav__brand {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    /* Keeps the 68px bar height with the mark optically centred in it. */
    padding-block: 12px;
    text-decoration: none;
    transition: opacity 150ms ease;
  }

  @media (hover: hover) {
    .nav__brand:hover {
      opacity: 0.75;
    }
  }

  .nav__menu {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px;
    /* Pulls the last link's padding back to the measure. */
    margin-right: -10px;
  }

  .nav__link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    /* 44px touch target on every link, including on a touchscreen laptop. */
    min-height: 44px;
    padding-inline: 10px;
    font-size: 15px;
    font-weight: 450;
    color: var(--grey);
    text-decoration: none;
    transition: color 150ms ease;
  }

  @media (hover: hover) {
    .nav__link:hover {
      color: var(--fg);
      text-decoration: none;
    }
  }

  /* Current page is marked by weight and a rule, never by colour alone. */
  .nav__link[aria-current='page'] {
    color: var(--fg);
    font-weight: 600;
    box-shadow: inset 0 -2px 0 var(--accent);
  }

  .nav__external {
    font-family: var(--mono);
    font-size: 11px;
  }

  /* On a phone the brand keeps its own row and the links sit beneath it.
     Left to wrap on their own the six go 5 + 1, which strands "Credits" on a
     line by itself and leaves the bar 185px tall — close to a quarter of the
     screen before a word of the page. A 3 x 2 grid is the same six links,
     every one still visible and one tap away, in 25px less height, and it
     reads as a menu rather than as an accident of wrapping. */
  @media (max-width: 34rem) {
    .nav__inner {
      gap: 0;
      /* Two short rows: the single-row height no longer describes this bar. */
      min-height: 0;
      padding-bottom: 10px;
    }

    .nav__brand {
      padding-block: 12px 6px;
    }

    /* The mark is the one thing here that can afford to be smaller. At 124px
       it stands taller than both rows of links put together. */
    .nav__brand :global(img) {
      width: 100px;
    }

    .nav__menu {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      /* Pulls the padding of both edge columns back off the measure, so the
         first label starts flush with the wordmark above it. */
      width: calc(100% + 20px);
      margin-inline: -10px;
    }

    .nav__link {
      min-height: 40px;
    }
  }
</style>
